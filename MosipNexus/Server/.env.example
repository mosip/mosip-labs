# =============================================================================
# Nexus Server — environment template
# Copy to Server/.env and fill in values before first run.
#
#   copy Server\.env.example Server\.env
#
# On Rancher/K8s these map to the nexus-env Secret (Server/k8s/02-secret.yaml).
# =============================================================================

# ── Required: PostgreSQL (pgvector) ───────────────────────────────────────────
# See docs/DATABASE_SETUP.md (this folder) for full checklist.
PG_CONNECTION=postgresql+psycopg://mosip:mosip@localhost:5432/mosipnexus

# ── Product identity (crawl/ingest defaults — one active crawl target) ────────
# Interactive chat can switch MOSIP ↔ Inji per request via X-Nexus-Product.
PRODUCT_NAME=MOSIP Nexus
PRODUCT_SHORT=MOSIP
PRODUCT_SLUG=mosip
DEFAULT_PRODUCT=mosip

# Runtime product profiles (chat/search). Override URLs/collections per product:
# MOSIP_PRODUCT_NAME=MOSIP Nexus
# MOSIP_DOCS_BASE_URL=https://docs.mosip.io/1.2.0
# MOSIP_COMMUNITY_BASE_URL=https://community.mosip.io
# MOSIP_GITHUB_ORG=mosip
# MOSIP_DOCS_COLLECTION=mosip_docs
# MOSIP_COMMUNITY_COLLECTION=mosip_community
# MOSIP_GITHUB_COLLECTION=mosip_github
# MOSIP_CODE_COLLECTION=mosip_code
#
# INJI_PRODUCT_NAME=Inji Nexus
# INJI_DOCS_BASE_URL=https://docs.inji.io
# INJI_COMMUNITY_BASE_URL=https://community.mosip.io/c/inji/16
# INJI_GITHUB_ORG=mosip
# INJI_DOCS_COLLECTION=inji_docs
# INJI_COMMUNITY_COLLECTION=inji_community
# INJI_GITHUB_COLLECTION=inji_github
# INJI_CODE_COLLECTION=inji_code

# Generic / white-label (direct BYOK — no docs URLs required):
# GENERIC_PRODUCT_NAME=Nexus
# GENERIC_PRODUCT_SHORT=Assistant
# GENERIC_DEFAULT_ANSWER_MODE=direct
# GENERIC_RETRIEVAL_ENABLED=false
# GENERIC_SYSTEM prompt is passed per-request via /chat system_prompt

# Example: crawl/ingest for Inji instead of MOSIP:
# PRODUCT_NAME=Inji Nexus
# PRODUCT_SHORT=Inji
# PRODUCT_SLUG=inji
# DOCS_BASE_URL=https://docs.inji.io
# COMMUNITY_BASE_URL=https://community.mosip.io/c/inji/16

# ── Knowledge / crawl targets (defaults for PRODUCT_SLUG ingest) ──────────────
DOCS_BASE_URL=https://docs.mosip.io/1.2.0
# DOCS_SITEMAP_URL=https://docs.mosip.io/1.2.0/sitemap.xml
COMMUNITY_BASE_URL=https://community.mosip.io
COMMUNITY_NEW_TOPIC_PATH=/new-topic

GITHUB_ORG=mosip
# Fallback repos when GITHUB_TOKEN is empty (comma-separated owner/name)
# GITHUB_REPOS=mosip/id-authentication,mosip/registration
# GITHUB_REPO_EXCLUDE=documentation,.github,mosip-acceptance-tests

# ── Optional: Groq (ingestion summarizer only — NOT used for chat BYOK) ───────
GROQ_API_KEY=gsk_your_key_here

# ── Optional: HuggingFace token (avoids rate-limiting on model downloads) ──────
HF_TOKEN=hf_your_token_here

# ── Optional: LangSmith observability ─────────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=lsv2_pt_your_key_here
LANGCHAIN_PROJECT=mosip-nexus

# ── Optional: GitHub crawler (strongly recommended) ───────────────────────────
GITHUB_TOKEN=ghp_your_token_here

# ── Optional: Confluence crawler ──────────────────────────────────────────────
CONFLUENCE_URL=https://yourorg.atlassian.net/wiki
CONFLUENCE_USER=your_email@example.com
CONFLUENCE_TOKEN=your_atlassian_api_token
CONFLUENCE_SPACE_KEYS=MOSIP,MOSIPDEV

# ── Optional: Jira crawler ────────────────────────────────────────────────────
JIRA_URL=https://yourorg.atlassian.net
JIRA_USER=your_email@example.com
JIRA_TOKEN=your_atlassian_api_token
JIRA_PROJECT_KEYS=MOSIP,MISP

# ── Optional: Email notifications ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASSWORD=your_app_password_here
NOTIFY_EMAIL=team@example.com

# ── Concurrency / scale (many parallel users) ─────────────────────────────────
# Keep UVICORN_WORKERS=1 unless sessions move to Redis (HF model is ~1GB each).
UVICORN_WORKERS=1
UVICORN_LIMIT_CONCURRENCY=64
MAX_CONCURRENT_CHATS=32
RETRIEVAL_PARALLELISM=4
EMBED_CACHE_SIZE=512
PG_POOL_SIZE=10
PG_MAX_OVERFLOW=20
PG_POOL_TIMEOUT=30
SESSION_TTL_SECONDS=3600
SESSION_MAX_COUNT=5000

# ── BYOK token budget (chat) — raise only if you need more recall ──────────────
# RETRIEVAL_K=4
# RETRIEVAL_FETCH_K=16
# MAX_CONTEXT_DOCS=8
# MAX_CONTEXT_CHARS=12000
# LLM_MAX_HISTORY_MESSAGES=6
# LLM_MAX_HISTORY_CHARS=600
# LLM_MAX_OUTPUT_TOKENS=1200
# WEB_SEARCH_MAX_RESULTS=2
# MAX_WEB_CONTEXT_CHARS=3500

# ── Logging ───────────────────────────────────────────────────────────────────
# LOG_LEVEL=INFO          # DEBUG | INFO | WARNING | ERROR
# LOG_FORMAT=text         # text | json (for log aggregators)
# LOG_ACCESS=true         # HTTP access lines (method path → status elapsed)

# ── Optional: MCP (Claude Desktop) ────────────────────────────────────────────
# Compose sets MCP_TRANSPORT=sse for nexus-mcp. Local stdio is the code default.
# MCP_TRANSPORT=sse
# MCP_PORT=8002
# Pin default product for tools that omit product= (dual Claude entries use this):
# MCP_DEFAULT_PRODUCT=mosip
# MCP_DEFAULT_PRODUCT=inji
