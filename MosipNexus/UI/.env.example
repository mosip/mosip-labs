# =============================================================================
# Nexus UI (React) — environment template
# Copy to UI/.env for local Vite dev:
#
#   copy UI\.env.example UI\.env
#
# Browser calls /api (proxied). In Docker/nginx, /api → nexus-api:8000.
# =============================================================================

# Vite dev proxy target (Server published on host :8010 by compose)
VITE_DEV_API_PROXY=http://localhost:8010

# Leave empty to use same-origin /api (recommended with nginx or Vite proxy).
# Set only if the API is on another origin without a proxy:
# VITE_NEXUS_API_URL=http://localhost:8010
