# ── Secrets ───────────────────────────────────────────────────────────────────
.env
**/.env
.env.*
!**/.env.example
!.env.example
# Generated by seal-secrets.sh — contains encrypted cluster-specific secrets
**/k8s/02-sealed-secret.yaml
# Local overrides referenced by deploy/*/README.md and helm/*/README.md
# my-secrets.env: optional OPTIONAL secret.env keys (dotenv format) for
#   deploy/nexus-server/install.sh — GITHUB_TOKEN, GROQ_API_KEY, SMTP_*, ...
#   POSTGRES_PASSWORD/PG_CONNECTION are never written to a file at all; the
#   script prompts for them interactively and stores them straight into a
#   kubectl-managed Secret.
# my-values.yaml: non-secret Helm values overrides (storageClassName, image.tag, ...)
**/my-secrets.env
**/my-values.yaml

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd

# ── Vector database (generated — rebuild with ingestion/store.py) ─────────────
chroma_db/

# ── Crawled data — JSON files ARE committed so cloners skip the 10-hour crawl
# Exceptions: crawl_state (runtime), confluence and jira data (may contain internal secrets)
**/data/crawl_state.json
**/data/*_community.json
**/data/*_confluence.json
**/data/*_jira.json
**/data/*_code.json

# ── pg_dump / zip exports — large binaries, not for git ──────────────────────
**/nexus_vectors.dump
**/nexus_vectors.zip
chroma_db/
**/chroma_db/

# ── Virtual environment (per Server/ and UI/) ─────────────────────────────────
.venv/
**/.venv/

# ── Node (UI) ─────────────────────────────────────────────────────────────────
**/node_modules/

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Test cache ────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
