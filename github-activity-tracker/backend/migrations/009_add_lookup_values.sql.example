-- Template: add new assignable roles and/or tracked organizations.
--
-- How to use:
--   1. Copy this file to the next numbered migration, e.g. 009_add_lookup_values.sql
--   2. Replace the example rows below with the values you need
--   3. Run: npm run migrate
--
-- Notes:
--   - slug must be lowercase (used in APIs and role assignment)
--   - name is the display label shown in the UI
--   - ON CONFLICT makes this safe to re-run
--   - GITHUB_ORG in .env controls GitHub sync; add the org here too if users
--     should be assignable to it via POST /admin/users/role

-- Add new roles
INSERT INTO user_roles (name) VALUES
  ('Security Engineer'),
  ('Scrum Master')
ON CONFLICT (name) DO NOTHING;

-- Add new organizations
INSERT INTO organizations (slug, name) VALUES
  ('mosip-sandbox', 'MOSIP-SANDBOX'),
  ('neworg', 'NEWORG')
ON CONFLICT (slug) DO NOTHING;
